# Send a password reset link. Start the API with Aspire first. The email shows up in Mailpit.
@host = http://localhost:5279

### Create an account → 201. Send it once: the second time is 409.
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "reset@example.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### Known email → 202, and an email in Mailpit.
POST {{host}}/api/v1/password-resets
Content-Type: application/json

{
  "email": "reset@example.com"
}

### Unknown email → 202 as well, and no email.
POST {{host}}/api/v1/password-resets
Content-Type: application/json

{
  "email": "nobody@example.com"
}

### Not an email → 400 validation.
POST {{host}}/api/v1/password-resets
Content-Type: application/json

{
  "email": "not-an-email"
}
