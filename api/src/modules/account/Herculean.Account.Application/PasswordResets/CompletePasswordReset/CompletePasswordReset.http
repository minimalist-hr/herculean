# Set a new password. Start the API with Aspire first, and copy the token from the email in Mailpit.
@host = http://localhost:5279
@token = paste-the-token-from-the-email

### Valid token → 204. Send it twice: the second time is 404, because a token works once.
POST {{host}}/api/v1/password-resets/complete
Content-Type: application/json

{
  "token": "{{token}}",
  "password": "new-password"
}

### Unknown token → 404 user.invalid_password_reset_token.
POST {{host}}/api/v1/password-resets/complete
Content-Type: application/json

{
  "token": "not-a-real-token",
  "password": "new-password"
}

### Short password → 400 validation.
POST {{host}}/api/v1/password-resets/complete
Content-Type: application/json

{
  "token": "{{token}}",
  "password": "short"
}
