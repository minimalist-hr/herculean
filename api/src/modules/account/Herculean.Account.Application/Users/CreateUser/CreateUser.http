# Create an account. Start the API with Aspire first.
@host = http://localhost:5279

### Create an account → 201 with tokens. Send it once: a second send is the next request.
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "fmucnjak@herculean.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### Create the same account twice → the second send is 409 user.email_taken.
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "Filip@Example.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### Invalid fields → 400 validation, with errors for email, password and timeZone.
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "filip",
  "password": "short",
  "timeZone": "Mars/Olympus"
}
