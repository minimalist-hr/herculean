# Change the password. Every device but this one is signed out. Start the API with Aspire first.
@host = http://localhost:5279
@accessToken = paste-an-access-token
@refreshToken = paste-this-devices-refresh-token

### The right current password → 204.
PUT {{host}}/api/v1/users/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "password",
  "newPassword": "new-password",
  "refreshToken": "{{refreshToken}}"
}

### The wrong current password → 400, the errors name the field.
PUT {{host}}/api/v1/users/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "wrong",
  "newPassword": "new-password",
  "refreshToken": "{{refreshToken}}"
}
