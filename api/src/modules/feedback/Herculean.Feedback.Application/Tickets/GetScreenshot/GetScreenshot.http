# Get a screenshot. Start the API with Aspire first, then send the first requests once.
@host = http://localhost:5279

### Create an account → 201. The requests below use its access token.
# @name createAccount
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "user-{{$guid}}@example.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### Feedback → 201. The requests below use it. The screenshot is the smallest JPEG start.
# @name createTicket
POST {{host}}/api/v1/feedback
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "type": "bug",
  "message": "The rest timer stops when the phone locks.",
  "screenshots": ["/9j/4A=="],
  "appVersion": "1.0.0",
  "phone": "Google Pixel 8",
  "os": "Android 15"
}

### The ticket → 200. The request below uses its screenshot.
# @name ticket
GET {{host}}/api/v1/feedback/{{createTicket.response.body.$.id}}
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### The screenshot → 200, as a Base64 JPEG.
GET {{host}}/api/v1/feedback/{{createTicket.response.body.$.id}}/screenshots/{{ticket.response.body.$.messages[0].screenshotIds[0]}}
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### A screenshot that does not exist → 404 ticket.screenshot_not_found.
GET {{host}}/api/v1/feedback/{{createTicket.response.body.$.id}}/screenshots/0198a000-0000-7000-8000-000000000000
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
