# Change a routine. Start the API with Aspire first, then send "Create an account" once.
@host = http://localhost:5279

### Create an account → 201. The requests below use its access token.
# @name createAccount
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "user-{{$guid}}@example.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### The groups → 200. A new account's groups can take a moment to appear.
# @name groups
GET {{host}}/api/v1/groups
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### An exercise → 201. The requests below use it.
# @name createExercise
POST {{host}}/api/v1/exercises
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Squat",
  "groupId": "{{groups.response.body.$[5].id}}"
}

### A routine → 201. The requests below use it.
# @name createRoutine
POST {{host}}/api/v1/routines
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Legs",
  "exercises": [
    {
      "exerciseId": "{{createExercise.response.body.$.id}}",
      "targetSets": 3,
      "targetRepsFrom": 8,
      "targetRepsTo": 10
    }
  ]
}

### New name and targets → 200.
PUT {{host}}/api/v1/routines/{{createRoutine.response.body.$.id}}
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Lower body",
  "exercises": [
    {
      "exerciseId": "{{createExercise.response.body.$.id}}",
      "targetSets": 4,
      "targetRepsFrom": 6,
      "targetRepsTo": 8
    }
  ]
}

### No exercises → 400 validation, with an error for exercises.
PUT {{host}}/api/v1/routines/{{createRoutine.response.body.$.id}}
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Lower body",
  "exercises": []
}
