# Get a routine. Start the API with Aspire first, then send "Create an account" once.
@host = http://localhost:5279

### Create an account → 201. The requests below use its access token.
# @name createAccount
POST {{host}}/api/v1/users
Content-Type: application/json

{
  "email": "user-{{$guid}}@example.com",
  "password": "password",
  "timeZone": "Europe/Zagreb"
}

### The groups → 200. A new account's groups can take a moment to appear.
# @name groups
GET {{host}}/api/v1/groups
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### An exercise → 201. The requests below use it.
# @name createExercise
POST {{host}}/api/v1/exercises
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Squat",
  "groupId": "{{groups.response.body.$[5].id}}"
}

### A routine → 201. The requests below use it.
# @name createRoutine
POST {{host}}/api/v1/routines
Authorization: Bearer {{createAccount.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Legs",
  "weekdays": ["monday"],
  "exercises": [
    {
      "exerciseId": "{{createExercise.response.body.$.id}}",
      "targetSets": 3,
      "targetRepsFrom": 8,
      "targetRepsTo": 10
    }
  ]
}

### The routine → 200, with its days, exercises and targets.
GET {{host}}/api/v1/routines/{{createRoutine.response.body.$.id}}
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### A routine that does not exist → 404 routine.not_found.
GET {{host}}/api/v1/routines/0198a000-0000-7000-8000-000000000000
Authorization: Bearer {{createAccount.response.body.$.accessToken}}

### Not signed in → 401 unauthorized.
GET {{host}}/api/v1/routines/{{createRoutine.response.body.$.id}}
