# Start or end a superset in a workout. Start the API with Aspire first, and fill in the IDs from a workout in progress.
@host = http://localhost:5279
@accessToken = paste-an-access-token
@workoutId = 00000000-0000-0000-0000-000000000000
@workoutExerciseId = 00000000-0000-0000-0000-000000000000

### Pair it with the exercise after it → 200 with the workout, or 409 workout.superset_not_two.
PUT {{host}}/api/v1/workouts/{{workoutId}}/exercises/{{workoutExerciseId}}/superset
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "supersetWithNext": true
}

### End its superset → 200.
PUT {{host}}/api/v1/workouts/{{workoutId}}/exercises/{{workoutExerciseId}}/superset
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "supersetWithNext": false
}
