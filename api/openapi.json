{
  "openapi": "3.1.1",
  "info": {
    "title": "Herculean API",
    "description": "The API of Herculean, a workout log for people who train on a fixed weekly split.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create an account",
        "description": "Creates an account and signs it in. Name, units and default rest time are set afterwards, in setup.",
        "operationId": "CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The account was created and is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change the signed-in user",
        "description": "Changes the name, units or time zone. Setup sends the name and units; the app sends a new time zone when the phone's changes.",
        "operationId": "UpdateCurrentUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrentUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The user after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The account no longer exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the signed-in user",
        "description": "Returns the signed-in user. A user without a name has not finished setup.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The account no longer exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Sign in",
        "description": "Signs in with email and password and returns new tokens. The email can be in any case.",
        "operationId": "CreateSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "The email or password is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is wrong. The message never says which.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/refresh": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Refresh the tokens",
        "description": "Swaps a refresh token for a new access token and a new refresh token. The old refresh token stops working.",
        "operationId": "RefreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New tokens. Keep the new refresh token; the old one no longer works.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "The refresh token is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The refresh token is unknown, already used or expired. Sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workout-settings": {
      "patch": {
        "tags": [
          "Workout settings"
        ],
        "summary": "Change the workout settings",
        "description": "Changes the default rest time, rest sound or rest vibrate. A new account starts at 3:00 (180 seconds), with sound and vibrate on.",
        "operationId": "UpdateWorkoutSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkoutSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The workout settings after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutSettingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email, in any case."
          },
          "password": {
            "type": "string",
            "description": "The account's password."
          }
        },
        "description": "Email and password to sign in with."
      },
      "CreateUserRequest": {
        "required": [
          "email",
          "password",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Unique regardless of case. At most 254 characters."
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters."
          },
          "timeZone": {
            "type": "string",
            "description": "The phone's IANA time zone, for example Europe/Zagreb."
          }
        },
        "description": "A new account."
      },
      "ProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A link to the HTTP status in RFC 9110."
          },
          "title": {
            "type": "string",
            "description": "The HTTP status name, for example Conflict."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code.",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "A sentence that explains the error."
          },
          "code": {
            "type": "string",
            "description": "A stable code for the app, for example user.email_taken. Field errors have validation."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Only when the code is validation: messages per field, with field names as in the request."
          },
          "traceId": {
            "type": "string",
            "description": "Finds the request in the logs."
          }
        },
        "description": "An error, as Problem Details (RFC 9457). Every error has the same fields."
      },
      "RefreshSessionRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refreshToken from signing in, creating the account or the last refresh. It works once."
          }
        },
        "description": "The refresh token to swap for new tokens."
      },
      "TokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "A JWT. Send it as `Authorization: Bearer <accessToken>`."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the access token expires.",
            "format": "int32"
          },
          "refreshToken": {
            "type": "string",
            "description": "Gets new tokens when the access token expires. Keep it in secure storage."
          }
        },
        "description": "The OAuth 2.0 token response (RFC 6749), in camelCase."
      },
      "Units": {
        "enum": [
          "metric",
          "imperial"
        ],
        "description": "The units the app shows and takes: metric in kg and cm, imperial in lb and in. The app converts; the API keeps weights in kg."
      },
      "UpdateCurrentUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "1 to 50 characters, trimmed."
          },
          "units": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The units the app shows weights and lengths in.",
                "$ref": "#/components/schemas/Units"
              }
            ]
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ],
            "description": "The phone's IANA time zone, for example Europe/Zagreb. Sent when the phone's changes."
          }
        },
        "description": "The fields to change. A field left out, or null, stays the same."
      },
      "UpdateWorkoutSettingsRequest": {
        "type": "object",
        "properties": {
          "defaultRestSeconds": {
            "type": [
              "null",
              "integer"
            ],
            "description": "The rest time that starts after every checked set, in seconds: a multiple of 15, from 15 to 600.",
            "format": "int32"
          },
          "restSound": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Play a sound when the rest ends."
          },
          "restVibrate": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Vibrate when the rest ends."
          }
        },
        "description": "The fields to change. A field left out, or null, stays the same."
      },
      "UserResponse": {
        "required": [
          "email",
          "name",
          "units",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Lowercase. Unique regardless of case."
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Null until setup. The greeting uses its first word."
          },
          "units": {
            "description": "The units the app shows weights and lengths in.",
            "$ref": "#/components/schemas/Units"
          },
          "timeZone": {
            "type": "string",
            "description": "The phone's IANA time zone, for example Europe/Zagreb. Dates and days use it."
          }
        },
        "description": "The signed-in user."
      },
      "WorkoutSettingsResponse": {
        "required": [
          "defaultRestSeconds",
          "restSound",
          "restVibrate"
        ],
        "type": "object",
        "properties": {
          "defaultRestSeconds": {
            "type": "integer",
            "description": "The rest time that starts after every checked set, in seconds: a multiple of 15, from 15 to 600.",
            "format": "int32"
          },
          "restSound": {
            "type": "boolean",
            "description": "Play a sound when the rest ends."
          },
          "restVibrate": {
            "type": "boolean",
            "description": "Vibrate when the rest ends."
          }
        },
        "description": "The signed-in user's workout settings."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "The accessToken from creating an account or signing in.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Users"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Workout settings"
    }
  ]
}