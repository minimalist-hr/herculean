{
  "openapi": "3.1.1",
  "info": {
    "title": "Herculean API",
    "description": "The API of Herculean, a workout log for people who train on a fixed weekly split.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create an account",
        "description": "Creates an account and signs it in. Name, units and default rest time are set afterwards, in setup.",
        "operationId": "CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The account was created and is signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "An account with this email already exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change the signed-in user",
        "description": "Changes the name, units or time zone. Setup sends the name and units; the app sends a new time zone when the phone's changes.",
        "operationId": "UpdateCurrentUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCurrentUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The user after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The account no longer exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get the signed-in user",
        "description": "Returns the signed-in user. A user without a name has not finished setup.",
        "operationId": "GetCurrentUser",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The account no longer exists.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Sign in",
        "description": "Signs in with email and password and returns new tokens. The email can be in any case.",
        "operationId": "CreateSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "The email or password is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The email or password is wrong. The message never says which.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/refresh": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Refresh the tokens",
        "description": "Swaps a refresh token for a new access token and a new refresh token. The old refresh token stops working.",
        "operationId": "RefreshSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "New tokens. Keep the new refresh token; the old one no longer works.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "The refresh token is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "The refresh token is unknown, already used or expired. Sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-resets": {
      "post": {
        "tags": [
          "Password resets"
        ],
        "summary": "Send a password reset link",
        "description": "Emails a link to set a new password. The answer is the same whether or not the email has an account, so it never tells which emails do. A new link cancels older ones.",
        "operationId": "CreatePasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted. If the email has an account, the link is on its way."
          },
          "400": {
            "description": "The email is missing or not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/links/reset-password": {
      "get": {
        "tags": [
          "Password resets"
        ],
        "summary": "Open a password reset link",
        "description": "The page the email links to. It opens the app's new password screen, or its reset password screen when the link is unknown, used or expired.",
        "operationId": "OpenResetLink",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "The token from the email.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page that opens the app.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/password-resets/complete": {
      "post": {
        "tags": [
          "Password resets"
        ],
        "summary": "Set a new password",
        "description": "Sets the new password with the token from the reset link. The link stops working and every device is signed out.",
        "operationId": "CompletePasswordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletePasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The password is changed. Sign in with the new one."
          },
          "400": {
            "description": "The token is missing, or the password is too short.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The token is unknown, already used or expired. Send a new link.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many tries from this address. Wait a minute; Retry-After says how long.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workout-settings": {
      "patch": {
        "tags": [
          "Workout settings"
        ],
        "summary": "Change the workout settings",
        "description": "Changes the default rest time, rest sound or rest vibrate. A new account starts at 3:00 (180 seconds), with sound and vibrate on.",
        "operationId": "UpdateWorkoutSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkoutSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The workout settings after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutSettingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/exercises": {
      "get": {
        "tags": [
          "Exercises"
        ],
        "summary": "List the exercises",
        "description": "Returns the signed-in user's exercises by group order, then name. Search and group narrow the list. Deleted exercises are left out.",
        "operationId": "ListExercises",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the exercise's name, in any case.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "groupId",
            "in": "query",
            "description": "Only exercises in this group.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The exercises. Empty when none match.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExerciseListItemResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The search is too long, or the group is not a valid ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "post": {
        "tags": [
          "Exercises"
        ],
        "summary": "Create an exercise",
        "description": "Adds an exercise to the signed-in user's list, in a group and with any other groups it also works.",
        "operationId": "CreateExercise",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExerciseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new exercise.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseResponse"
                }
              }
            }
          },
          "400": {
            "description": "A field is not valid. The errors name each one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "One of the groups does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The user already has an exercise with this name, or has reached the limit of 500 exercises.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/exercises/{id}": {
      "get": {
        "tags": [
          "Exercises"
        ],
        "summary": "Get an exercise",
        "description": "Returns one of the signed-in user's exercises, with its group and the other groups it also works.",
        "operationId": "GetExercise",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The exercise's ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The exercise.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseDetailsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The exercise does not exist, is deleted, or belongs to another user.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/groups": {
      "get": {
        "tags": [
          "Groups"
        ],
        "summary": "List the groups",
        "description": "Returns the signed-in user's groups in their order. Deleted groups are left out. A new account starts with six.",
        "operationId": "ListGroups",
        "responses": {
          "200": {
            "description": "The groups.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GroupResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in, or the access token expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BestSetResponse": {
        "required": [
          "weightKg",
          "reps",
          "date"
        ],
        "type": "object",
        "properties": {
          "weightKg": {
            "type": "number",
            "description": "The weight in kg. A bodyweight set has 0.",
            "format": "double"
          },
          "reps": {
            "type": "integer",
            "description": "The reps.",
            "format": "int32"
          },
          "date": {
            "type": "string",
            "description": "The date of the workout, in the user's time zone.",
            "format": "date"
          }
        },
        "description": "The best set of an exercise."
      },
      "CompletePasswordResetRequest": {
        "required": [
          "token",
          "password"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the reset link. It works once."
          },
          "password": {
            "type": "string",
            "description": "The new password, at least 8 characters."
          }
        },
        "description": "The token from the reset link, and the new password."
      },
      "CreateExerciseRequest": {
        "required": [
          "name",
          "groupId",
          "alsoWorksGroupIds"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name, 1 to 100 characters. Spaces around it are removed. It must differ from the user's other exercises, regardless of case."
          },
          "groupId": {
            "type": "string",
            "description": "The group it belongs to, which orders the exercise list.",
            "format": "uuid"
          },
          "alsoWorksGroupIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Other groups it also works. Optional. It can't repeat a group, or include the group it belongs to."
          }
        },
        "description": "A new exercise."
      },
      "CreatePasswordResetRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email. Not case-sensitive."
          }
        },
        "description": "Where to send the password reset link."
      },
      "CreateSessionRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email, in any case."
          },
          "password": {
            "type": "string",
            "description": "The account's password."
          }
        },
        "description": "Email and password to sign in with."
      },
      "CreateUserRequest": {
        "required": [
          "email",
          "password",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Unique regardless of case. At most 254 characters."
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters."
          },
          "timeZone": {
            "type": "string",
            "description": "The phone's IANA time zone, for example Europe/Zagreb."
          }
        },
        "description": "A new account."
      },
      "ExerciseDetailsResponse": {
        "required": [
          "id",
          "name",
          "group",
          "alsoWorksGroups"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The exercise's ID.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The exercise's name."
          },
          "group": {
            "description": "The group it belongs to.",
            "$ref": "#/components/schemas/GroupResponse"
          },
          "alsoWorksGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupResponse"
            },
            "description": "The other groups it also works, in their order."
          }
        },
        "description": "An exercise and its groups."
      },
      "ExerciseListItemResponse": {
        "required": [
          "id",
          "name",
          "groupId",
          "groupName",
          "bestSet"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The exercise's ID.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The exercise's name."
          },
          "groupId": {
            "type": "string",
            "description": "The group it belongs to.",
            "format": "uuid"
          },
          "groupName": {
            "type": "string",
            "description": "The name of the group it belongs to."
          },
          "bestSet": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The heaviest weight, then the most reps at that weight. Null until the exercise has been done.",
                "$ref": "#/components/schemas/BestSetResponse"
              }
            ]
          }
        },
        "description": "An exercise in the list."
      },
      "ExerciseResponse": {
        "required": [
          "id",
          "name",
          "groupId",
          "alsoWorksGroupIds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The exercise's ID.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The exercise's name."
          },
          "groupId": {
            "type": "string",
            "description": "The group it belongs to.",
            "format": "uuid"
          },
          "alsoWorksGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The other groups it also works."
          }
        },
        "description": "An exercise."
      },
      "GroupResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The group's ID.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "The group's name."
          }
        },
        "description": "A muscle group. It orders the exercise list and the chips."
      },
      "ProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "A link to the HTTP status in RFC 9110."
          },
